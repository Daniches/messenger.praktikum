{
  "name": "messenger.praktikum",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && vite preview --port 3000",
    "preview": "vite preview",
    "prebuild": "tsc --noEmit",
    "lint:ts": "eslint . --ext .ts",
    "lint:ts:fix": "eslint . --ext .ts --fix",
    "lint:css": "stylelint src/style.css src/components/**/*.css",
    "lint:css:fix": "stylelint src/style.css src/components/**/*.css --fix",
    "lint": "npm run lint:ts && npm run lint:css"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "jiti": "^2.6.1",
    "postcss-preset-env": "^11.2.0",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript-eslint": "^8.58.0",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@material-symbols/font-400": "^0.40.2",
    "handlebars": "^4.7.8"
  }
