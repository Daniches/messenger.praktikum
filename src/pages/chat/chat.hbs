<div class="page-container">
    <div class="chat-page-container">
        {{> chat-list}}
        <div class="chat-page-container__content">
            {{> chat-header}}
            <main class="content-container">
                <div class="messages-container">
                {{#each messages}}
                        {{{MessageItem my=my message=message time=time}}}
                    {{/each}}
                </div>
            </main>
            {{{ ChatFooter messageValidation=messageValidation }}}
        </div>
    </div>    
    {{> navigation-footer}}
</div>
