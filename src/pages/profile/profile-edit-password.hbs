<div class="page-container">
    {{> navigation-header page_name="Обновить пароль"}}
    <main class="content-container">
        <form class="card-form">
            <div class="card-form__block-wrapper">
                {{> input-field 
                    type="password"
                    name="old_password"
                    label="Текущий пароль"
                    id="user-old-password"
                }}
                {{> input-field 
                    type="password"
                    name="new_password"
                    label="Новый пароль"
                    id="user-password"
                }}
                {{> input-field 
                    type="password"
                    name="new_password_repeat"
                    label="Повторите пароль"
                    id="user-password-repeat"
                }}
            </div>
            <div class="card-form__block-wrapper">
                {{> button variant="primary" text="Сохранить" type="submit"}}
                {{> button variant="tertiary" text="Отмена"}}
            </div>
        </form>
    </main>
    {{> navigation-footer}}
</div>