<div class="page-container">
    {{> navigation-header page_name="Изменить данные"}}
    <main class="content-container">
        <form class="card-form">
            <div class="card-form__block-wrapper">
                <div class="card-form__line-wrapper">
                    {{> input-field
                        type="text"
                        name="first_name"
                        label="Имя"
                        id="user-firstname"
                        value="Михаил"
                    }}
                    {{> input-field
                        type="text"
                        name="second_name"
                        label="Фамилия"
                        id="user-secondname"
                        value="Мишкин"
                    }}
                </div>
                {{> input-field
                    type="text"
                    name="login"
                    label="Логин"
                    id="user-login"
                    value="my_login"
                }}
                {{> input-field 
                    type="email"
                    name="email"
                    label="Email"
                    id="user-email"
                    value="test@mail.ru"
                }}
                {{> input-field 
                    type="tel"
                    name="phone"
                    label="Телефон"
                    id="user-phone"
                    value="+7 (123) 456-78-90"
                }}
            </div>
            <div class="card-form__block-wrapper">
                {{> button variant="primary" text="Сохранить" type="submit"}}
                {{> button variant="tertiary" text="Отмена"}}
            </div>
        </form>
    </main>
    {{> navigation-footer}}
</div>
