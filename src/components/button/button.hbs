<button 
    class="button button_variant_{{default variant "primary"}} button_style_{{default style "rounded"}}"
    {{parameter "type" type "button"}}
    {{parameter "ref" ref}}
>
    {{#if icon}} 
        {{> icon icon_name=icon additional_classes='button__icon'}}
    {{/if}}
    
    {{#if text}}
        <span>{{text}}</span>
    {{/if}}
</button>
